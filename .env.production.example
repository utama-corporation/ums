# Production environment template for docker-compose.prod.yml.
#
# 1. Copy this file to `.env.production` (never commit that file — it holds real secrets).
# 2. Replace every value below marked CHANGE_ME. Generate strong secrets with:
#      openssl rand -hex 32
# 3. DATABASE_URL / REDIS_HOST / SMTP_HOST are set automatically by docker-compose.prod.yml
#    to point at the in-stack containers — you do not need (and should not) set them here;
#    they're listed for reference only. S3_* is NOT auto-set (MinIO is not part of this
#    stack) — either fill in your external MinIO/S3 here as a bootstrap fallback, or leave
#    the placeholders and configure it entirely from Settings > Lampiran File after deploy.

NODE_ENV=production
PORT=5500
WEB_PORT=5000

# Public URLs — change these to your real domain/IP once you have one.
# APP_URL must exactly match the origin the browser uses, or cookies/CORS will fail.
APP_URL=http://CHANGE_ME:5000
API_URL=http://CHANGE_ME:5500
NEXT_PUBLIC_API_URL=http://CHANGE_ME:5500/api/v1

# PostgreSQL (container-internal; docker-compose fills DATABASE_URL for the app services)
POSTGRES_USER=ums_user
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_DB=ums_db

# Session signing secret — MUST be freshly generated, never reuse the dev value.
# The API refuses to start in production if this is left at its default.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Encrypts secrets (currently: the S3/MinIO secret key) stored via the Settings UI at
# rest in the database. MUST be freshly generated, never reuse the dev value — the API
# refuses to start in production if this is left at its default.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# S3 / MinIO — this is now ONLY a fallback used before an admin configures real values
# in Settings > Lampiran File. There is no bundled MinIO container in docker-compose.prod.yml
# (point the app at your own external MinIO/S3-compatible server via the Settings UI instead).
S3_ENDPOINT=http://CHANGE_ME:9000
S3_REGION=us-east-1
S3_BUCKET=ums-attachments
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Email — Mailpit (bundled) is a dev-only catcher, it does NOT deliver real mail.
# Replace with your real SMTP relay before this system sends anything to real users.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Utama Memo System <noreply@yourdomain.example>"

LOG_LEVEL=info

# External HR employee directory (used for user provisioning + auto-disable sync)
EMPLOYEE_API_BASE_URL=https://emp.padmoasm.com/api/v1/q
EMPLOYEE_API_TOKEN=
