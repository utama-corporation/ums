# Node Environment
NODE_ENV=development
PORT=5500
WEB_PORT=5000

# Application URLs
APP_URL=http://localhost:5000
API_URL=http://localhost:5500

# Database
DATABASE_URL=postgresql://ums_user:ums_password@localhost:5432/ums_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session / JWT Secret
SESSION_SECRET=dev_super_secret_session_key_change_in_production_32chars

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ums-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Utama Memo System <noreply@utama.co.id>"

# Logging
LOG_LEVEL=debug

# External HR employee directory
EMPLOYEE_API_BASE_URL=https://emp.padmoasm.com/api/v1/q
EMPLOYEE_API_TOKEN=
